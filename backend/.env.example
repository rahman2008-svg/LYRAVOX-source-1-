# Copy to .env (local) or set these in the Render dashboard. There are NO secrets: no API keys are needed anywhere.

# --- model -------------------------------------------------------------
WHISPER_MODEL=base            # tiny | base | small | medium | large-v3  (bigger = more accurate for Bangla/Hindi, slower, more RAM)
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8          # int8 is the right choice on CPU
WHISPER_BEAM=5
# WHISPER_CACHE=/models       # where model files are stored (set in the Docker image)
PRELOAD_MODEL=1               # load the model at start in the background

# --- limits ------------------------------------------------------------
MAX_UPLOAD_MB=50
MAX_DURATION_S=900            # longest audio (or clip) accepted
CHUNK_S=300                   # long audio is processed in chunks of about this many seconds, cut at silences
MAX_CONCURRENT_JOBS=1         # jobs processed at the same time
MAX_QUEUE=6                   # waiting + running jobs; more are refused with 503
MAX_ACTIVE_PER_IP=2
JOB_TIMEOUT_S=1800
JOB_TTL_S=1800                # results are forgotten after this long

# --- languages / CORS --------------------------------------------------
ALLOWED_LANGUAGES=bn,en,hi
ALLOWED_ORIGINS=https://your-frontend.vercel.app   # comma separated; '*' allows every site (fine for testing)

# --- optional vocal separation (needs requirements-demucs.txt) ---------
DEMUCS_ENABLED=1
DEMUCS_MODEL=htdemucs
DEMUCS_TIMEOUT_S=900

# --- misc --------------------------------------------------------------
INTERLUDE_MIN_S=6             # gaps at least this long between lyric lines are reported as instrumental
# LYRAVOX_TMP=/tmp/lyravox-ai
